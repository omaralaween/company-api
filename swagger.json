    "/employees": {
      "post": {
        "summary": "Create a new employee",
        "tags": [
          "Employees"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "firstName",
                  "lastName",
                  "department",
                  "role",
                  "companyId"
                ],
                "properties": {
                  "firstName": {
                    "type": "string",
                    "example": "John"
                  },
                  "lastName": {
                    "type": "string",
                    "example": "Doe"
                  },
                  "department": {
                    "type": "string",
                    "example": "Engineering"
                  },
                  "role": {
                    "type": "string",
                    "example": "Software Developer"
                  },
                  "companyId": {
                    "type": "integer",
                    "example": 3
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Employee created successfully!"
          },
          "400": {
            "description": "one of the fields is not provided!"
          },
          "401": {
            "description": "not logged in / invalid or expired token"
          },
          "403": {
            "description": "Unauthorized user!"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all employees",
        "tags": [
          "Employees"
        ],
        "security": [
